\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Results across three teacher\,$\rightarrow $\,student settings on nine datasets. Emotion, WiC, and STS-B (marked with $\star $) are in-domain; the remaining datasets are out-of-domain. Bold and underlined values denote the best and second-best results within each setting, excluding the Teacher and Student base reference rows. TALAS and RIPPLE results are reported as mean $\pm $ standard deviation; the remaining baseline results are from TALAS~\citep  {dao2026talas}. For setting (c), the epoch checkpoint is selected on the validation average.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:main_results}{{1}{7}{Results across three teacher\,$\rightarrow $\,student settings on nine datasets. Emotion, WiC, and STS-B (marked with $\star $) are in-domain; the remaining datasets are out-of-domain. Bold and underlined values denote the best and second-best results within each setting, excluding the Teacher and Student base reference rows. TALAS and RIPPLE results are reported as mean $\pm $ standard deviation; the remaining baseline results are from TALAS~\citep {dao2026talas}. For setting (c), the epoch checkpoint is selected on the validation average}{table.1}{}}
