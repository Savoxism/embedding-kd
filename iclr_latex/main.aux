\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Build-time diagnostics of the scale family equation~\ref {eq:family} for the Qwen3-Embedding-4B teacher ($k=50$, $\tau _g=0.05$), averaged over anchors and evaluated on the retained pool. Sharpness is the first quantity in equation~\ref {eq:diag1}, in nats; a value near $0$ would indicate a binary neighbour label. Residual is $\varepsilon _{i,r}$ of equation~\ref {eq:target}. The zero-step scale is dense on $C_i$ by construction and is reported separately in the text.}}{17}{table.4}\protected@file@percent }
\newlabel{tab:diag}{{4}{17}{Build-time diagnostics of the scale family \eqref {eq:family} for the Qwen3-Embedding-4B teacher ($k=50$, $\tau _g=0.05$), averaged over anchors and evaluated on the retained pool. Sharpness is the first quantity in \eqref {eq:diag1}, in nats; a value near $0$ would indicate a binary neighbour label. Residual is $\varepsilon _{i,r}$ of \eqref {eq:target}. The zero-step scale is dense on $C_i$ by construction and is reported separately in the text}{table.4}{}}
